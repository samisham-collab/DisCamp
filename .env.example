# Copy this file to .env and fill in what you need. .env is never committed.

# --- Supabase (optional) ---------------------------------------------------
# From Supabase: Project Settings > API. Without both values, the app uses the
# starter spots bundled in src/data/seedSpots.ts.
# The publishable key is safe to ship in the app. Never put the secret
# (service role) key here or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Maps for Android builds (needed for Android builds) -------------
# Not needed for Expo Go or iPhone. Android builds show a blank map without it.
# For EAS builds, add it on expo.dev as an environment variable instead.
# See app.config.ts.
GOOGLE_MAPS_ANDROID_API_KEY=
